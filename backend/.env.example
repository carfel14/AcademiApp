# Base creada con database/AcademiaBellezaSilvia.sql
DB_DATABASE=AcademiaBellezaSilvia
PORT=3000

# LocalDB (Windows). El backend inicia la instancia y detecta su canal np: solo.
# Si prefieres fijarlo a mano, usa DB_LOCALDB_PIPE='np:\\.\pipe\LOCALDB#...\tsql\query'.
DB_LOCALDB_INSTANCE=MSSQLLocalDB

# Conexión TCP a un SQL Server normal (se usa si no hay DB_LOCALDB_INSTANCE).
DB_SERVER=localhost
DB_PORT=1433
DB_USER=academiapp_user
DB_PASSWORD=

# Clave para «Configurar primer acceso» (crear la cuenta ADMINISTRADOR).
APP_SETUP_KEY=

# Clave para firmar los tokens de sesión (genera una larga y aleatoria).
APP_TOKEN_SECRET=
